+// Marymount: branded idle screen — HD crest on the school navy, connection steps on a card
+private val MarymountNavy = Color(0xFF023E7C)
+private val MarymountNavyDeep = Color(0xFF01264D)
+
+@Composable
+private fun MarymountWelcome(name: String, requirePin: Boolean) {
+    BoxWithConstraints(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(Brush.linearGradient(listOf(MarymountNavy, MarymountNavyDeep)))
+            .padding(32.dp)
+    ) {
+        val wide = maxWidth > maxHeight * 1.15f
+        val logoSize = if (wide) minOf(maxHeight * 0.62f, maxWidth * 0.30f)
+        else minOf(maxWidth * 0.42f, maxHeight * 0.26f)
+        val crest = ImageBitmap.imageResource(R.drawable.marymount_logo)
+        val logoView: @Composable () -> Unit = {
+            Box(
+                modifier = Modifier
+                    .size(logoSize)
+                    .shadow(24.dp, CircleShape)
+                    .clip(CircleShape)
+                    .background(Color.White)
+                    .padding(logoSize * 0.035f),
+                contentAlignment = Alignment.Center
+            ) {
+                Image(
+                    bitmap = crest,
+                    contentDescription = stringResource(R.string.mm_logo_cd),
+                    filterQuality = FilterQuality.High,
+                    modifier = Modifier.fillMaxSize()
+                )
+            }
+        }
+        val card: @Composable (Modifier) -> Unit = { mod ->
+            Surface(
+                modifier = mod,
+                shape = RoundedCornerShape(32.dp),
+                color = MaterialTheme.colorScheme.surface,
+                shadowElevation = 16.dp
+            ) {
+                Column(modifier = Modifier.padding(horizontal = 40.dp, vertical = 36.dp)) {
+                    Text(
+                        text = stringResource(R.string.mm_welcome_title).uppercase(),
+                        style = MaterialTheme.typography.labelLarge,
+                        letterSpacing = 1.5.sp,
+                        fontWeight = FontWeight.SemiBold,
+                        color = MaterialTheme.colorScheme.primary
+                    )
+                    Spacer(Modifier.height(6.dp))
+                    Text(
+                        text = name,
+                        style = MaterialTheme.typography.displayMedium,
+                        fontWeight = FontWeight.Bold,
+                        color = MaterialTheme.colorScheme.onSurface
+                    )
+                    Spacer(Modifier.height(24.dp))
+                    MarymountStep(1, stringResource(R.string.mm_step1)) {
+                        Row(
+                            verticalAlignment = Alignment.CenterVertically,
+                            modifier = Modifier
+                                .padding(top = 10.dp)
+                                .clip(RoundedCornerShape(50))
+                                .background(MaterialTheme.colorScheme.primaryContainer)
+                                .padding(horizontal = 18.dp, vertical = 8.dp)
+                        ) {
+                            Icon(
+                                imageVector = Icons.Rounded.Wifi,
+                                contentDescription = null,
+                                tint = MaterialTheme.colorScheme.onPrimaryContainer,
+                                modifier = Modifier.size(24.dp)
+                            )
+                            Spacer(Modifier.width(10.dp))
+                            Text(
+                                text = stringResource(R.string.mm_wifi_name),
+                                style = MaterialTheme.typography.titleLarge,
+                                fontWeight = FontWeight.Bold,
+                                color = MaterialTheme.colorScheme.onPrimaryContainer
+                            )
+                        }
+                    }
+                    MarymountStep(2, stringResource(R.string.mm_step2))
+                    MarymountStep(3, stringResource(R.string.mm_step3, name))
+                    if (requirePin) MarymountStep(4, stringResource(R.string.mm_step_pin))
+                    HorizontalDivider(
+                        modifier = Modifier.padding(vertical = 20.dp),
+                        color = MaterialTheme.colorScheme.outlineVariant
+                    )
+                    MarymountTip(Icons.Rounded.LaptopMac, stringResource(R.string.mm_tip_mac))
+                    Spacer(Modifier.height(10.dp))
+                    MarymountTip(Icons.Rounded.SmartDisplay, stringResource(R.string.mm_tip_youtube))
+                }
+            }
+        }
+        if (wide) {
+            Row(
+                modifier = Modifier.fillMaxSize(),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.Center
+            ) {
+                logoView()
+                Spacer(Modifier.width(56.dp))
+                card(
+                    Modifier
+                        .weight(1f, fill = false)
+                        .widthIn(max = 780.dp)
+                        .verticalScroll(rememberScrollState())
+                )
+            }
+        } else {
+            Column(
+                modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()),
+                horizontalAlignment = Alignment.CenterHorizontally,
+                verticalArrangement = Arrangement.Center
+            ) {
+                logoView()
+                Spacer(Modifier.height(28.dp))
+                card(Modifier.widthIn(max = 780.dp))
+            }
+        }
+    }
+}
+
+@Composable
+private fun MarymountStep(number: Int, text: String, extra: (@Composable () -> Unit)? = null) {
+    Row(
+        verticalAlignment = Alignment.Top,
+        modifier = Modifier.padding(vertical = 10.dp)
+    ) {
+        Box(
+            modifier = Modifier
+                .size(40.dp)
+                .clip(CircleShape)
+                .background(MaterialTheme.colorScheme.primary),
+            contentAlignment = Alignment.Center
+        ) {
+            Text(
+                text = number.toString(),
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+                color = MaterialTheme.colorScheme.onPrimary
+            )
+        }
+        Spacer(Modifier.width(18.dp))
+        Column(modifier = Modifier.padding(top = 5.dp)) {
+            Text(
+                text = text,
+                style = MaterialTheme.typography.titleLarge,
+                color = MaterialTheme.colorScheme.onSurface
+            )
+            extra?.invoke()
+        }
+    }
+}
+
+@Composable
+private fun MarymountTip(icon: ImageVector, text: String) {
+    Row(verticalAlignment = Alignment.CenterVertically) {
+        Icon(
+            imageVector = icon,
+            contentDescription = null,
+            tint = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.size(22.dp)
+        )
+        Spacer(Modifier.width(12.dp))
+        Text(
+            text = text,
+            style = MaterialTheme.typography.bodyLarge,
+            color = MaterialTheme.colorScheme.onSurfaceVariant
+        )
+    }
+}
