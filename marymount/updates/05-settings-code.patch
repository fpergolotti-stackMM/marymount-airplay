+// Marymount: numeric code dialog guarding Settings
+@Composable
+private fun MarymountSettingsCodeDialog(expected: String, onDismiss: () -> Unit, onUnlock: () -> Unit) {
+    var code by remember { mutableStateOf("") }
+    var wrong by remember { mutableStateOf(false) }
+    val focus = remember { FocusRequester() }
+    val submit: () -> Unit = {
+        if (code == expected) {
+            onUnlock()
+        } else {
+            wrong = true
+            code = ""
+        }
+    }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        icon = { Icon(Icons.Default.Lock, contentDescription = null) },
+        title = { Text(stringResource(R.string.mm_settings_code_title)) },
+        text = {
+            Column {
+                Text(stringResource(R.string.mm_settings_code_desc))
+                Spacer(Modifier.height(12.dp))
+                OutlinedTextField(
+                    value = code,
+                    onValueChange = { v ->
+                        code = v.filter(Char::isDigit).take(12)
+                        wrong = false
+                        if (code == expected) onUnlock()
+                    },
+                    singleLine = true,
+                    isError = wrong,
+                    supportingText = { if (wrong) Text(stringResource(R.string.mm_settings_code_wrong)) },
+                    visualTransformation = PasswordVisualTransformation(),
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword, imeAction = ImeAction.Done),
+                    keyboardActions = KeyboardActions(onDone = { submit() }),
+                    modifier = Modifier.focusRequester(focus)
+                )
+            }
+        },
+        confirmButton = { TextButton(onClick = { submit() }) { Text(stringResource(R.string.mm_settings_code_ok)) } },
+        dismissButton = { TextButton(onClick = onDismiss) { Text(stringResource(R.string.mm_settings_code_cancel)) } }
+    )
+    LaunchedEffect(Unit) { runCatching { focus.requestFocus() } }
+}
