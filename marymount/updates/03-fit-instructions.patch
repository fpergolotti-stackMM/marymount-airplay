+// Marymount: lays out [content] at full size; if it is taller than the space available,
+// it is laid out again with a proportionally smaller density (text, icons and spacing
+// all shrink together) so that everything stays visible without scrolling.
+@Composable
+private fun MarymountFitToHeight(modifier: Modifier = Modifier, content: @Composable () -> Unit) {
+    val base = LocalDensity.current
+    SubcomposeLayout(modifier) { constraints ->
+        val free = constraints.copy(minWidth = 0, minHeight = 0)
+        val probe = subcompose("probe", content).map { it.measure(free.copy(maxHeight = Constraints.Infinity)) }
+        val natural = probe.maxOfOrNull { it.height } ?: 0
+        val limit = constraints.maxHeight
+        val placeables = if (limit != Constraints.Infinity && natural > limit && natural > 0) {
+            val factor = (limit.toFloat() / natural * 0.98f).coerceIn(0.45f, 1f)
+            subcompose("fit") {
+                CompositionLocalProvider(
+                    LocalDensity provides Density(base.density * factor, base.fontScale)
+                ) { content() }
+            }.map { it.measure(free) }
+        } else probe
+        val w = placeables.maxOfOrNull { it.width } ?: 0
+        val h = (placeables.maxOfOrNull { it.height } ?: 0).coerceAtMost(limit)
+        layout(w, h) { placeables.forEach { it.place(0, 0) } }
+    }
+}
