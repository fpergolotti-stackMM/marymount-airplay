@@ -0,0 +1,27 @@
+package io.github.jqssun.airplay
+
+import android.content.Context
+import android.os.Build
+import android.provider.Settings
+
+private const val MAX_NAME_LENGTH = 40
+
+/**
+ * Marymount: name advertised when none is set in the app. Uses the device name configured in
+ * Android Settings (or pushed by the display management console) unless it is just the model
+ * name, otherwise falls back to "LIM " + the last four characters of the Android ID, so that
+ * every panel gets a distinct, stable name.
+ */
+fun autoServerName(ctx: Context): String {
+    val cr = ctx.contentResolver
+    // "device_name" == Settings.Global.DEVICE_NAME (API 25+); the literal keeps API 24 builds happy
+    val configured = runCatching { Settings.Global.getString(cr, "device_name") }.getOrNull()?.trim().orEmpty()
+    val model = Build.MODEL?.trim().orEmpty()
+    val generic = configured.isEmpty() ||
+        (model.length >= 3 && configured.contains(model, ignoreCase = true)) ||
+        configured.equals("Android", ignoreCase = true)
+    if (!generic) return configured.take(MAX_NAME_LENGTH)
+    val id = runCatching { Settings.Secure.getString(cr, Settings.Secure.ANDROID_ID) }.getOrNull().orEmpty()
+    val suffix = id.takeLast(4).uppercase().ifEmpty { "0000" }
+    return "Screen $suffix"
+}
