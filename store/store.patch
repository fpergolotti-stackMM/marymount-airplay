+package io.github.jqssun.airplay
+
+import android.content.Context
+import android.content.RestrictionsManager
+import android.content.SharedPreferences
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.net.Uri
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.InputStream
+import java.net.HttpURLConnection
+import java.net.URL
+
+/** Store edition: customisable waiting screen (logo, colour, texts). */
+object Branding {
+    private const val LOGO_FILE = "brand_logo.img"
+    private const val MAX_LOGO_BYTES = 5 * 1024 * 1024
+    val COLOR = Regex("#?[0-9a-fA-F]{6}")
+
+    fun logoFile(ctx: Context) = File(ctx.filesDir, LOGO_FILE)
+
+    /** Copies a picked image into app storage; returns the new pref value, or null if not an image. */
+    fun importLogo(ctx: Context, uri: Uri): String? = runCatching {
+        ctx.contentResolver.openInputStream(uri)?.use { _readLimited(it) }?.let { _store(ctx, it) }
+    }.getOrNull()
+
+    /** Downloads a logo (managed configuration "brand_logo_url"); returns the new pref value or null. */
+    fun downloadLogo(ctx: Context, url: String): String? = runCatching {
+        val conn = URL(url).openConnection() as HttpURLConnection
+        conn.connectTimeout = 10_000
+        conn.readTimeout = 15_000
+        conn.instanceFollowRedirects = true
+        try {
+            if (conn.responseCode !in 200..299) null
+            else conn.inputStream.use { _readLimited(it) }?.let { _store(ctx, it) }
+        } finally {
+            conn.disconnect()
+        }
+    }.getOrNull()
+
+    fun removeLogo(ctx: Context) {
+        logoFile(ctx).delete()
+    }
+
+    /** Decodes the stored logo, downsampled to at most [maxPx] on its long side. */
+    fun loadLogo(ctx: Context, maxPx: Int = 1024): Bitmap? = runCatching {
+        val f = logoFile(ctx)
+        if (!f.exists()) return@runCatching null
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(f.path, bounds)
+        var sample = 1
+        while (maxOf(bounds.outWidth, bounds.outHeight) / sample > maxPx) sample *= 2
+        BitmapFactory.decodeFile(f.path, BitmapFactory.Options().apply { inSampleSize = sample })
+    }.getOrNull()
+
+    /** "#RRGGBB" or "RRGGBB" to an opaque ARGB int. */
+    fun parseColor(s: String): Int? = s.trim().takeIf { COLOR.matches(it) }
+        ?.removePrefix("#")?.toLongOrNull(16)?.let { (0xFF000000L or it).toInt() }
+
+    private fun _store(ctx: Context, bytes: ByteArray): String? {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+        logoFile(ctx).writeBytes(bytes)
+        return LOGO_FILE + "#" + System.currentTimeMillis()
+    }
+
+    private fun _readLimited(input: InputStream): ByteArray? {
+        val out = ByteArrayOutputStream()
+        val buf = ByteArray(16 * 1024)
+        while (true) {
+            val n = input.read(buf)
+            if (n < 0) break
+            out.write(buf, 0, n)
+            if (out.size() > MAX_LOGO_BYTES) return null
+        }
+        return out.toByteArray()
+    }
+}
+
+/**
+ * Store edition: Android managed configurations (res/xml/app_restrictions.xml), so schools and
+ * companies can set name, branding and behaviour from their device-management console.
+ * Values go through the same validation as the adb SettingsReceiver.
+ */
+object ManagedConfig {
+    private val KEYS = listOf(
+        "server_name", "require_pin", "launch_on_connect", "return_on_disconnect", "boot_auto_start",
+        "resolution", "max_fps", "hls_audio_language",
+        "brand_org_name", "brand_title", "brand_wifi_name", "brand_color", "brand_show_tips",
+    )
+
+    /** Applies the managed values; returns the configured logo URL, if any. */
+    fun apply(ctx: Context): String? {
+        val rm = ctx.getSystemService(Context.RESTRICTIONS_SERVICE) as? RestrictionsManager ?: return null
+        val b = rm.applicationRestrictions ?: return null
+        if (b.isEmpty) return null
+        val prefs = ctx.getSharedPreferences(Prefs.NAME, Context.MODE_PRIVATE)
+        for (key in KEYS) {
+            if (!b.containsKey(key)) continue
+            @Suppress("DEPRECATION")
+            val raw = b.get(key) ?: continue
+            Prefs.all[key]?.writeText(prefs, raw.toString())
+        }
+        return b.getString("brand_logo_url")?.trim()?.takeIf { it.isNotEmpty() }
+    }
+
+    private fun <T : Any> Pref<T>.writeText(p: SharedPreferences, s: String) {
+        parse(s)?.let { write(p, it) }
+    }
+}
